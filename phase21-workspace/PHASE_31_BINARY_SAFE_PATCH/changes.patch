++++++++++    let objects = query_strings(
++++++++++        &conn,
++++++++++        "SELECT type || ':' || name FROM sqlite_master ORDER BY type, name",
++++++++++        500,
++++++++++    )?;
++++++++++    let _ = objects; // census retained in report digest via sorted findings only
