+++++fn fingerprint(sql_normalized: &str) -> String {
+++++    use sha2::{Digest as _, Sha256};
+++++    let mut h = Sha256::new();
+++++    h.update(sql_normalized.as_bytes());
+++++    let d = h.finalize();
+++++    d.iter().map(|b| format!("{b:02x}")).collect()
+++++}
