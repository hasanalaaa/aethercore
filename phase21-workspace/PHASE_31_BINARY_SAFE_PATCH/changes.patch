++++++++++/// Cap on parsed log entries per file (hostile-input clamp).
++++++++++pub const MAX_ENTRIES: usize = 50_000;
++++++++++/// Default top-N reported.
++++++++++pub const DEFAULT_TOP: usize = 10;
