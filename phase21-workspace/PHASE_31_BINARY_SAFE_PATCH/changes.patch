++++++        "err.keysGenerateRequiresOut" => "`keys generate` requires `--out <path>`",
++++++        "err.keysFingerprintRequiresIn" => "`keys fingerprint` requires `--in <path>`",
++++++        "err.dbSubcommandRequired" => {
