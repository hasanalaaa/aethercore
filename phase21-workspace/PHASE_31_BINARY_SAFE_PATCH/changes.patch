+++++++++sha_map = {f: sha256(ROOT / f) for f in changed + added}
+++++++++manifest = {
+++++++++    "schema": "aethercore.phase30.binary-safe-patch.v1",
+++++++++    "base": "sealed-P29-archive",
+++++++++    "files": changed + [f"+{a}" for a in sorted(added)],
+++++++++    "modifiedCount": len(changed),
+++++++++    "addedCount": len(added),
+++++++++    "removedCount": 0,
+++++++++    "sha256": sha_map,
