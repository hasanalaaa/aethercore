+    pass
+checks += p30.checks
+failures.extend(str(f) for f in p30.failures)
+
+# ======================= Phase 31 gates ====================================
+
+# --- Gate a/b: docs integrity -----------------------------------------------------
+required_docs = [
+    "docs/phase29/ARCHITECTURE.md",
+    "docs/phase29/SCORECARD.md",
+    "docs/phase29/MASTER_DELIVERY_REPORT.md",
+    "docs/phase29/QUALIFICATION_DEBT.json",
