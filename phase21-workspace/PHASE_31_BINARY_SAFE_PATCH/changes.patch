+++    for line in String::from_utf8_lossy(data)
+++        .lines()
+++        .take(config_lint::MAX_DIRECTIVES)
+++    {
+++        if crate::config_lint::parse_pg_line_public(line).is_some() {
+++            n += 1;
+++        }
+++    }
+++    n
+++}
