++++        }
++++        if !line.trim().is_empty() {
++++            in_query = true;
++++            current_sql.push_str(line);
++++            current_sql.push(' ');
++++        } else if in_query {
++++            flush!();
++++        }
++++    }
++++    flush!();
++++    build_report("mysqlSlowLog", path, aggs, samples, top)
++++}
