+++    if let (Some(listen), ssl) = (get("listen_addresses"), get("ssl")) {
+++        let exposed = listen.value == "*" || listen.value == "0.0.0.0";
+++        let ssl_on = ssl.map(|d| boolish(&d.value)).unwrap_or(false);
+++        if exposed && !ssl_on {
