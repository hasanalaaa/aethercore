+++++#[derive(Default)]
+++++struct Agg {
+++++    count: u64,
+++++    total_ms: f64,
+++++    max_ms: f64,
+++++    ratio_flag: bool,
+++++}
+++++
+++++impl Agg {
+++++    fn push(&mut self, ms: f64, ratio_flag: bool) {
+++++        self.count += 1;
+++++        self.total_ms += ms;
+++++        self.max_ms = self.max_ms.max(ms);
+++++        self.ratio_flag |= ratio_flag;
+++++    }
+++++}
