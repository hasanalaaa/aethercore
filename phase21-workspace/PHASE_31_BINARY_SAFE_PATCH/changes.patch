+
+# --- Gate a: read-only contract ---------------------------------------------------
+check("p30-crate-exists", DB_SRC.exists(), "crates/db-diagnostics/src missing")
+all_src = ""
+for name in CRATE_FILES:
+    p = DB_SRC / name
