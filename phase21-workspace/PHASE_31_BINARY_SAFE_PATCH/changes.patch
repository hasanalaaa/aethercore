++++++/// EN catalog — keyed by the same stable keys.
++++++pub fn en(key: &str) -> &'static str {
++++++    match key {
++++++        "usage.header" => "aetherctl -- AetherCore headless command surface",
++++++        "usage.globalFlags" => "GLOBAL FLAGS (before the command):",
