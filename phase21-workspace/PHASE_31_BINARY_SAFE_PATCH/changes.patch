+}
+(PATCH / "MANIFEST.json").write_text(json.dumps(manifest, indent=1) + "\n", encoding="utf-8")
+
+# ---- FULL-TREE ledger ------------------------------------------------------------
+ledger_files = {}
+for path in sorted(ROOT.rglob("*")):
+    rel = str(path.relative_to(ROOT))
+    if any(part in EXCLUDED_DIRS for part in path.parts):
