+++++++++    z = ROOT.parent / "AetherCore-Phase29-Master-Delivery.zip"
+++++++++    if SEAL.exists():
+++++++++        shutil.rmtree(SEAL)
+++++++++    SEAL.mkdir(parents=True)
+++++++++    subprocess.run(["tar", "-xzf", str(z), "-C", str(SEAL), "--strip-components", "1"],
+++++++++                   check=True, capture_output=True)
