++    for line in text.lines() {
++        if let Some(rest) = line.strip_prefix("# Query_time:") {
++            flush!();
++            let mut it = rest.split_whitespace();
++            current_ms = it.next().and_then(|t| t.parse::<f64>().ok());
++            if let Some(li) = rest.find("Rows_sent:") {
