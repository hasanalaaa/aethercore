+def build(dest: Path):
+    if dest.exists():
+        dest.unlink()
+    staging = Path("/tmp/p31_archive_stage")
+    if staging.exists():
+        shutil.rmtree(staging)
+    stage_root = staging / NAME
+    stage_root.mkdir(parents=True)
+    for path in sorted(ROOT.rglob("*")):
+        rel = path.relative_to(ROOT)
+        if set(rel.parts) & EXCLUDE_DIRS:
+            continue
+        s = str(rel)
