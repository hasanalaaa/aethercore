+++++++++        b.iter(|| {
+++++++++            aethercore_db_diagnostics::sqlite_provider::diagnose_sqlite(&path_str)
+++++++++                .expect("diagnose")
+++++++++        })
+++++++++    });
+++++++++}
+++++++++
+++++++++criterion_group!(benches, bench_sqlite_diagnose_healthy);
+++++++++criterion_main!(benches);
