+impl ImmutableApplyPlan {
+    pub fn digest(&self) -> Result<String, AuthorityError> { Ok(sha256_hex(&canonical_json(self)?)) }
+    pub fn verify_unchanged(&self, expected_digest: &str) -> Result<(), AuthorityError> { if self.digest()? == expected_digest { Ok(()) } else { Err(AuthorityError::PlanChanged) } }
