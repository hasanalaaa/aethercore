+++++++    if any(part in EXCLUDED_DIRS for part in path.parts):
+++++++        continue
+++++++    if rel == "PHASE_30_BINARY_SAFE_PATCH/PHASE_30_EXPECTED_FULL_SHA256.json":
+++++++        continue
+++++++    if not path.is_file():
+++++++        continue
+++++++    full[rel] = sha256(path)
+++++++
+++++++diffs = []
