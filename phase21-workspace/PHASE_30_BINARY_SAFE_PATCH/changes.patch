++/// Parity helper used by the audit and tests: true when every KEYS entry resolves
++/// non-empty in BOTH catalogs.
++pub fn parity_ok() -> bool {
++    KEYS.iter().all(|k| !en(k).is_empty() && !ar(k).is_empty())
++}
