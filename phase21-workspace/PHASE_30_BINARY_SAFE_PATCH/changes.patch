++            continue;
++        }
++        let mut it = trimmed.splitn(2, ['=', ' ']);
++        let kw = it.next().unwrap_or("").trim().to_ascii_lowercase();
++        let val = it.next().unwrap_or("").trim();
++        if kw.is_empty() {
++            continue;
++        }
++        // First occurrence wins (matches sshd_config semantics).
++        if out
++            .iter()
++            .any(|(k, _, _, _): &(String, String, usize, String)| *k == kw)
