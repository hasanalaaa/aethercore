+++impl Lang {
+++    pub fn parse(value: &str) -> Option<Lang> {
+++        match value.trim().to_ascii_lowercase().as_str() {
+++            "ar" | "ar-eg" | "ara" => Some(Lang::Ar),
+++            "en" | "en-us" => Some(Lang::En),
