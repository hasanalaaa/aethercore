++++++++++                &format!("slowlog-ratio-{}/{}", path, row.fingerprint),
++++++++++                "db.slowlog.missingIndexSuspicion",
++++++++++                Severity::Warning,
++++++++++                ev,
++++++++++                "db.finding.slowLogMissingIndex",
++++++++++                Confidence::Measured,
++++++++++            ) {
++++++++++                f.message_args = samples.get(&row.fingerprint).cloned().into_iter().collect();
++++++++++                findings.push(f);
++++++++++            }
++++++++++        }
++++++++++    }
