++/// Translates a key in the given language (empty string when unknown — callers fall
++/// back to the key itself so nothing silently masquerades).
++pub fn t(lang: Lang, key: &str) -> &'static str {
++    match lang {
++        Lang::En => en(key),
++        Lang::Ar => ar(key),
++    }
++}
