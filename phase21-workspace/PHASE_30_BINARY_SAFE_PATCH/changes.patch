++++++++++++    if any(part in EXCLUDED_DIRS for part in path.parts):
++++++++++++        continue
++++++++++++    if rel.startswith("PHASE_30_BINARY_SAFE_PATCH"):
++++++++++++        continue
++++++++++++    if not path.is_file():
++++++++++++        continue
++++++++++++    sealed = SEAL / rel
