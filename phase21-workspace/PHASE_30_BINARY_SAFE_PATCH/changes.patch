++    for f in sorted {
++        let canonical = serde_json::to_vec(f).unwrap_or_default();
++        hasher.update((canonical.len() as u64).to_le_bytes());
++        hasher.update(canonical);
++    }
++    format!("{:x}", hasher.finalize())
++}
