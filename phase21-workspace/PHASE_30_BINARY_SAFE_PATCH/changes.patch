++++++++    let (findings, not_available) = config_lint::lint_postgres(dir.path()).expect("lint postgres");
++++++++    let mut codes: Vec<&str> = findings.iter().map(|f| f.code.as_str()).collect();
++++++++    codes.sort();
++++++++    assert_eq!(
++++++++        codes,
