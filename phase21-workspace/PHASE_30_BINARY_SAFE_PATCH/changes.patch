+++++++++++        if rel == SELF:
+++++++++++            seen.add(rel); continue
+++++++++++        if any(part in EXCLUDED_DIRS for part in path.parts) or not path.is_file():
+++++++++++            continue
+++++++++++        seen.add(rel)
+++++++++++        want = entries.get(rel)
