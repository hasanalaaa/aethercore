+        // Flip ONE byte of the page-1 b-tree header (offset 100) — reliably corrupts.
+        let mut bytes = std::fs::read(&corrupt).unwrap();
+        assert!(bytes.len() > 100);
+        bytes[100] ^= 0xFF;
+        std::fs::write(&corrupt, &bytes).unwrap();
