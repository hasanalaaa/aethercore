+++SKIP_PREFIXES = ("C:\\ProgramData",)
+++
+++
+++def build(dest: Path):
+++    if dest.exists():
+++        dest.unlink()
+++    staging = Path("/tmp/p32_archive_stage")
+++    if staging.exists():
+++        shutil.rmtree(staging)
+++    stage_root = staging / NAME
+++    stage_root.mkdir(parents=True)
+++    for path in sorted(ROOT.rglob("*")):
