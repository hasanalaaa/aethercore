++pub fn report_digest(findings: &[SecFinding]) -> String {
++    let mut sorted: Vec<&SecFinding> = findings.iter().collect();
++    sorted.sort_by(|a, b| {
++        b.severity
++            .cmp(&a.severity)
++            .then_with(|| a.code.cmp(&b.code))
++            .then_with(|| a.id.cmp(&b.id))
++            .then_with(|| {
++                let la = a
++                    .evidence
++                    .first()
++                    .map(|e| e.source_location.as_str())
++                    .unwrap_or("");
++                let lb = b
++                    .evidence
++                    .first()
++                    .map(|e| e.source_location.as_str())
++                    .unwrap_or("");
