+++++++++    tar = subprocess.Popen(tar_cmd, stdout=subprocess.PIPE, env=env)
+++++++++    gzip = subprocess.Popen(["gzip", "-n", "-9"], stdin=tar.stdout, stdout=open(dest, "wb"))
+++++++++    tar.stdout.close()
+++++++++    gzip.communicate()
