+++++++++++++
+++++++++++++/// Resolves the active language: flag > env > en.
+++++++++++++pub fn resolve(flag: Option<&str>) -> Lang {
+++++++++++++    if let Some(f) = flag {
+++++++++++++        if let Some(l) = Lang::parse(f) {
+++++++++++++            return l;
+++++++++++++        }
+++++++++++++    }
+++++++++++++    if let Ok(env) = std::env::var("AETHERCORE_LANG") {
+++++++++++++        if let Some(l) = Lang::parse(&env) {
+++++++++++++            return l;
+++++++++++++        }
+++++++++++++    }
+++++++++++++    Lang::En
