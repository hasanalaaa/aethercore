+++        continue
+++    if rel == ".DS_Store" or not path.is_file():
+++        continue
+++    ledger_files[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
+++
+++full = {
+++    "schema": "aethercore.phase32.full-sha256.v1",
