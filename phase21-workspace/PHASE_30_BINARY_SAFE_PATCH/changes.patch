++++++++        ]
++++++++    );
++++++++    // Every finding cites verbatim source lines.
++++++++    for f in &findings {
++++++++        for e in &f.evidence {
++++++++            assert!(e.source_location.contains("postgresql.conf"), "{e:?}");
