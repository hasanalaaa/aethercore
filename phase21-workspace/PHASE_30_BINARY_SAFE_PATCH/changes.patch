++        Some(pos) => line[pos + 6..]
++            .split_whitespace()
++            .next()
++            .unwrap_or("unknown")
++            .trim_end_matches(':').trim_end_matches(',')
++            .to_string(),
++        None => "unknown".to_string(),
++    }
++}
