++    let meta = std::fs::metadata(path).map_err(|e| format!("stat: {e}"))?;
++    if !meta.is_file() {
++        return Err(format!("not a regular file: {path_str}"));
++    }
++    if meta.len() > MAX_PARSE_BYTES as u64 {
++        return Err(format!("oversize: {} > {MAX_PARSE_BYTES}", meta.len()));
