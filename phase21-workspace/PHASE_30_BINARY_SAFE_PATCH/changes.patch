++++++++++++    let tmp = std::env::temp_dir().join(format!("p30fuzz-my-{}", std::process::id()));
++++++++++++    std::fs::write(&tmp, data).ok();
++++++++++++    let r = slow_log::analyze_mysql_log(tmp.to_str().unwrap_or(""), 10);
++++++++++++    let _ = std::fs::remove_file(&tmp);
++++++++++++    r.map(|_| 1).unwrap_or(0)
++++++++++++}
