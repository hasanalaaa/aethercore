+++# --- Gate g: full-tree hash standard continues ---------------------------------------
+++patch_dir = ROOT / "PHASE_30_BINARY_SAFE_PATCH"
+++full_hash = patch_dir / "PHASE_30_EXPECTED_FULL_SHA256.json"
