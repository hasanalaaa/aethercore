++    let dir = tempdir("gd5");
++    let db = dir.join("vulndb.json");
++    let mf = dir.join("vulndb.manifest.json");
++    let entries = r#"[{"cve_id":"CVE-2026-0001","package":"openssl","introduced":"","fixed":"3.0.14","summary":"x"}]"#;
