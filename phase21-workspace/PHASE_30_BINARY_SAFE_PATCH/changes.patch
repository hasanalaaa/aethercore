+        dest.write_text(''.join(out))
+    else:
+        src=(pathlib.Path('/tmp/p30_seal_extract/x')/f).read_text(errors='replace').splitlines(keepends=True)
+        out=[]; idx=0; plus=[]; active=False
+        for line in chunk.splitlines(keepends=True):
