<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Every NuGet package used by the packaging toolchain must be signed.
         This stays "require". It is not relaxed. -->
    <add key="signatureValidationMode" value="require" />
  </config>

  <!-- signatureValidationMode="require" means "allow only packages signed by a
       TRUSTED signer". Until now this file named no trusted signers at all, and
       NuGet says exactly what that means:

         error: NU3034: signatureValidationMode is set to require, so packages
         are allowed only if signed by trusted signers; however, no trusted
         signers were specified.

       CI run 34682395824 failed there restoring wix 6.0.2. The control read as
       strict while being, on any machine that enforced it, unsatisfiable - and
       it was masked locally, where the same cold restore succeeds on the same
       SDK (8.0.424). A control whose outcome depends on which machine runs it
       is not a control.

       Declaring the signers makes it operative rather than accidental. Both
       fingerprints below are the ones NuGet itself reported while verifying
       wix.6.0.2 in that run, not values copied from documentation.

       A package satisfies this if it matches EITHER entry, which is deliberate:
       author certificates rotate on a different schedule from the repository's,
       and losing the build to a certificate renewal is its own kind of failure.
       allowUntrustedRoot is false in both; these chain to public roots. -->
  <trustedSigners>
    <!-- FireGiant publishes the WiX toolset packages.
         Observed: CN=FireGiant, O=FireGiant, L=San Diego, S=California, C=US
                   valid 2023-10-04 to 2026-10-04 -->
    <author name="FireGiant">
      <certificate fingerprint="D95336DD2022934D80E3F3A4F938DD66EC7076BBBA680F76C11F2B54B346D61D"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
    </author>

    <!-- nuget.org counter-signs everything it serves.
         Observed: CN=NuGet.org Repository by Microsoft, L=Redmond, S=Washington, C=US
                   valid 2024-02-23 to 2027-05-18 -->
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
