+fn fleet_trust_store_checked() -> Result<aethercore_fleet::TrustStore, String> {
+    aethercore_fleet::TrustStore::open(&dirs_fleet_state().join("fleet").join("trust"))
+        .map_err(|error| format!("open fleet trust store: {error}"))
+}
