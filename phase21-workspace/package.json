{
  "name": "aethercore-workspace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File ./scripts/bootstrap.ps1",
    "verify": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify.ps1",
    "dev": "pwsh -ExecutionPolicy Bypass -File ./scripts/run-dev.ps1",
    "release": "pwsh -ExecutionPolicy Bypass -File ./scripts/build-release.ps1",
    "ui:dev": "pnpm --dir apps/ui dev",
    "ui:build": "pnpm --dir apps/ui build",
    "verify:phase2": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-phase2.ps1",
    "verify:phase6": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-phase6.ps1",
    "verify:phase7": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-phase7.ps1",
    "verify:phase11": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-phase11.ps1",
    "verify:phase12": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-phase12.ps1",
    "verify:phase13": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-phase13.ps1",
    "verify:zenith": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-zenith.ps1",
    "verify:zenith-recursive": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-zenith-recursive.ps1"
  }
}
