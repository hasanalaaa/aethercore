<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="AetherCore.Desktop"
      ProductCode="$(var.ProductCode)"
      UpgradeCode="{45598C77-2C32-5BCE-8510-19C7E51EE3B8}"
      Name="AetherCore"
      Manufacturer="AetherCore"
      Version="$(var.ProductVersion)"
      Language="1033"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">

    <SummaryInformation Description="AetherCore Windows maintenance and diagnostics suite" Manufacturer="AetherCore" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of AetherCore is already installed." />
    <!-- P36 Tranche 1 (Hermes): MSI WindowsBuild is compat-capped at 9600 (Windows 8.1
         values) for unmanifested packages on ALL modern Windows - the previous
         "WindowsBuild >= 22621" condition could never pass at runtime (verified in
         tranche1-msi-install.log: Property(S): WindowsBuild = 9600 on build 26200).
         Root-cause remedy: read the real build number from the registry
         (HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\CurrentBuildNumber), which
         is authoritative on every supported OS. Clients require build 22621+;
         Windows Server 2019 and newer require build 17763+. -->
    <Property Id="OSCURRENTBUILD" Value="0">
      <RegistrySearch Id="OsCurrentBuildNumber"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="WINDOWSINSTALLATIONTYPE">
      <RegistrySearch Id="WindowsInstallationType"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="InstallationType"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Launch
        Condition="VersionNT64 AND ((MsiNTProductType = 1 AND OSCURRENTBUILD &gt;= 22621) OR (MsiNTProductType = 3 AND OSCURRENTBUILD &gt;= 17763))"
        Message="AetherCore supports 64-bit Windows 11 build 22621+ and Windows Server 2019, 2022, or 2025+ (build 17763+)." />
    <Launch Condition="MsiNTProductType &lt;&gt; 2"
            Message="AetherCore does not support domain controllers." />

    <!-- DBT-P41-001. Five of the six shipped binaries import VCRUNTIME140.dll and the
         maintenance service also imports MSVCP140.dll. Those DLLs are NOT part of
         Windows: Microsoft's own "Redistribute Visual C++ Files" page says an
         application must deploy them, and that the redistributable should be run as a
         prerequisite before the application installs. Every qualification run in this
         project's history happened on a machine that already had them, so nothing ever
         tested the machine that does not.

         The bundle (Bundle.wxs) chains vc_redist and is the supported consumer path.
         This condition covers the other one: a direct msiexec /i on a machine without
         the runtime now REFUSES with a message naming what is missing, instead of
         installing successfully and failing at service start with a dialog about a
         missing DLL.

         The key is the one Microsoft documents for detection, and $(sys.BUILDARCH)
         selects the architecture the package was built for, exactly as the OpenMP file
         selection below does. Registry key names are case-insensitive, so arm64/x64
         match the keys the redistributable actually writes (measured on the ARM64
         qualification VM: Version=v14.44.35211.00, Installed=1, under
         Runtimes\arm64 and Runtimes\x64). Runtimes\debug\* is the
         debug_nonredist tree and is deliberately NOT what this reads. -->
    <Property Id="VCRUNTIMEVERSION">
      <RegistrySearch Id="VcRuntimeVersion"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\$(sys.BUILDARCH)"
                      Name="Version"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Launch
        Condition="VCRUNTIMEVERSION"
        Message="AetherCore requires the Microsoft Visual C++ 2015-2022 Redistributable ($(sys.BUILDARCH)), which is not installed on this computer. AetherCore's programs load VCRUNTIME140.dll and MSVCP140.dll from it. Install it first (search Microsoft for &quot;Visual C++ Redistributable&quot;, or run vc_redist.$(sys.BUILDARCH).exe), then run this installer again. AetherCoreSetup.exe installs it for you." />

    <!-- Direct MSI installs are supported for managed environments, but the consumer bundle is
         preferred because it also guarantees the Evergreen WebView2 prerequisite. Do not author
         ARPNOREPAIR: Windows Installer repair is intentionally part of the recovery contract. -->

    <!-- P36 (Hermes): ICE38/ICE43/ICE57 root-cause fix. The shortcut is non-advertised
         (Advertise="no") while the owning component's KeyPath is a file under
         ProgramFiles64Folder. Windows Installer treats ProgramMenuFolder under a
         per-machine install as the All Users profile, so the ICEs require the
         component's KeyPath to be a HKCU registry entry. Authoring the shortcut as
         ADVERTISED (Advertise="yes") is the documented root-cause remedy: an
         advertised shortcut may legally use the file KeyPath and no per-user
         KeyPath is needed. DISABLEADVTSHORTCUTS=1 makes Windows Installer materialize
         it as an ordinary .lnk at install time, so behavior remains a plain shortcut
         ("find target" still works). No ICE suppression is used. -->
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

    <!-- P37 Stage 2: uninstall leaves NOTHING behind. The statement below is what the
         OS uninstall UI (Settings > Apps, and Programs and Features) shows the user
         before they confirm; UNINSTALL.txt beside the product carries the full text. -->
    <Property Id="ARPCOMMENTS" Value="Uninstall removes the program files, the AetherCore Maintenance service, and ALL machine data under C:\ProgramData\AetherCore (state database, logs, driver-install backups, support staging, signing key). Reports and diagnostic bundles you exported to a location YOU chose are not touched. See UNINSTALL.txt in the install folder." />

    <!-- P47 item 3: the package had no product icon at all, so Add/Remove Programs
         showed the generic MSI box. The window and Start Menu shortcut icons were
         already correct because Tauri embeds icons/icon.ico into
         aethercore-desktop.exe; ARP reads the Icon table and there was nothing in
         it. Both now come from the same generated file.

         SourceFile, not Source: check-msi-payload.ps1 builds its allowlist from
         literal Source="..." strings and compares it to the MSI File table. An
         Icon is not a File row, so this neither joins that allowlist nor needs to.

         P48 item 2: the artwork is the product's mark, not a placeholder, and
         DBT-P36-004 is closed. design/icon/aethercore-mark.svg is the geometric
         AE ligature, monochrome #5C7CFA on #030508. Monochrome by design: plum
         is the denied-by-policy role, and spending it on an icon would cost
         that role its meaning. The owner replaces it by dropping a new SVG through
         tools/icon-pipeline/build-icons.mjs, which regenerates all seventeen
         files; apps/desktop/icons/SOURCE.json records which SVG made the
         committed set, by path and sha256. -->
    <Icon Id="ProductIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />


    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AetherCore">
        <Component Id="DesktopComponent" Guid="{A8D2C0D6-618A-4F34-8E5B-0F47B68D9D11}" Bitness="always64">
          <File Id="DesktopExe" Source="$(var.PayloadDir)\aethercore-desktop.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut"
                      Directory="AetherCoreProgramMenu"
                      Name="AetherCore"
                      Description="AetherCore"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
          </File>
        </Component>

        <Component Id="BrokerComponent" Guid="{D1D038D6-38D2-4D0C-9F24-32522707EA6A}" Bitness="always64">
          <File Id="ConsentBrokerExe" Source="$(var.PayloadDir)\aethercore-consent-broker.exe" KeyPath="yes" />
        </Component>

        <Component Id="UpdateBrokerComponent" Guid="{F2D37346-C4C8-49B7-A54A-70868D304BB2}" Bitness="always64">
          <File Id="UpdateBrokerExe" Source="$(var.PayloadDir)\aethercore-update-broker.exe" KeyPath="yes" />
        </Component>

        <!-- Release trust is installed read-only under Program Files. The default source template is
             disabled; production release automation may substitute an explicitly reviewed pinned
             Ed25519 channel configuration. No private update key is ever installed. -->
        <Component Id="UpdateTrustComponent" Guid="{1F71C1D9-1D7F-47F7-9294-14D89E629073}" Bitness="always64">
          <File Id="UpdateTrustJson" Source="$(var.PayloadDir)\update-trust.json" KeyPath="yes" />
        </Component>

        <Component Id="HardenerComponent" Guid="{7B4D12C1-EE65-402D-9229-B4B5D156B304}" Bitness="always64">
          <File Id="InstallHardenerExe" Source="$(var.PayloadDir)\aethercore-install-hardener.exe" KeyPath="yes" />
        </Component>

        <Component Id="ServiceComponent" Guid="{C6DA3E84-2EEC-4D98-9F5F-B1F47C366309}" Bitness="always64">
          <File Id="MaintenanceServiceExe" Source="$(var.PayloadDir)\aethercore-maintenance-service.exe" KeyPath="yes" />
          <!-- P36 Tranche 1 (Hermes): the ARM64 clang-cl build imports libomp140.aarch64.dll
               (verified via llvm-readobj coff-imports). The service's DLL search path does
               not include the build Redist dir, so the runtime DLL must be installed beside
               the service executable or SCM start fails with STATUS_DLL_NOT_FOUND (0xC0000135)
               which surfaces as Error 1920 and 1053. Non-System32 Microsoft VC runtime DLL
               colocated with its consumer; update-trust and binary authority unchanged.

               P41 (physical x64): the OpenMP runtime is ARCHITECTURE-SPECIFIC and this line
               was hard-coded to the ARM64 one, so the x64 package could not build at all.
               The ARM64 build uses clang-cl and imports the LLVM runtime libomp140.aarch64.dll;
               the x64 build uses MSVC and imports Microsoft's VCOMP140.DLL instead. Both were
               measured with llvm-readobj coff-imports on the actual binaries, not assumed.
               Selected here with the WiX preprocessor rather than a -d variable on purpose:
               scripts/check-msi-payload.ps1 derives its allowlist by reading the literal
               Source="…" strings out of this file, so a $(var.…) filename would make the
               authored name unmatchable and fail every build. Both literal names appear
               below, so the derived allowlist stays a superset and the package still carries
               exactly one of them. -->
          <?if $(sys.BUILDARCH) = arm64 ?>
          <File Id="OpenMPRuntimeDll" Source="$(var.PayloadDir)\libomp140.aarch64.dll" />
          <?else?>
          <File Id="OpenMPRuntimeDll" Source="$(var.PayloadDir)\vcomp140.dll" />
          <?endif?>
          <ServiceInstall
              Id="MaintenanceServiceInstall"
              Name="AetherCoreMaintenance"
              DisplayName="AetherCore Maintenance Service"
              Description="Privileged typed-operation engine for AetherCore."
              Account="LocalSystem"
              Type="ownProcess"
              Start="auto"
              ErrorControl="normal"
              Vital="yes" />
          <ServiceControl
              Id="MaintenanceServiceControl"
              Name="AetherCoreMaintenance"
              Start="install"
              Stop="both"
              Remove="uninstall"
              Wait="yes" />
        </Component>

        <!-- P37 Stage 1: aetherctl.exe was BUILT and hand-copied into INSTALLFOLDER but
             never authored here, so no MSI action owned it. A clean install put seven
             files on disk and the CLI was simply absent; the earlier clean-reinstall
             gate only passed because a leftover copy was already there. It is now a
             first-class component: installed, repaired and removed with the product. -->
        <!-- P37 Stage 2: the plain-language statement of what uninstall removes and what
             it keeps. ARPCOMMENTS carries the summary into the OS uninstall UI; this is
             the full text, readable before the user uninstalls. -->
        <Component Id="UninstallNoticeComponent" Guid="{2BDDC66A-D021-450F-9A27-53F0C063D1EA}" Bitness="always64">
          <File Id="UninstallNoticeTxt" Source="$(var.PayloadDir)\UNINSTALL.txt" KeyPath="yes" Name="UNINSTALL.txt" />
        </Component>

        <Component Id="AetherCtlComponent" Guid="{D842C7E7-DD4A-433F-88E6-6B7E812DC4C1}" Bitness="always64">
          <File Id="AetherCtlExe" Source="$(var.PayloadDir)\aetherctl.exe" KeyPath="yes" />
        </Component>

        <Directory Id="AssetsDir" Name="assets">
          <Directory Id="AssetsModelsDir" Name="models">
            <Directory Id="AssetsModelLicensesDir" Name="licenses">
              <!-- Own component: a File inherits its parent Component's directory, so
                   the licenses cannot be authored from inside ModelComponent. -->
              <Component Id="ModelLicenseComponent" Guid="{3B9B8BEF-C513-41F1-94BF-31394ACCF11D}" Bitness="always64">
                <File Id="ModelLicenseApache" Source="$(var.AssetsDir)\models\licenses\Apache-2.0.txt" KeyPath="yes" />
                <File Id="ModelLicenseQwenNotice" Source="$(var.AssetsDir)\models\licenses\Qwen-GGUF-NOTICE.txt" />
              </Component>
            </Directory>

            <!-- P37 Stage 1: the embedded reasoner is the PERMANENT default engine and it
                 is loaded at RUNTIME from <install dir>\assets\models (composition.rs
                 resolves product_dir from current_exe; llama.rs joins
                 EMBEDDED_MODEL_RELATIVE_PATH). The artifact was never authored, so every
                 installed instance failed verification at start and ran ruleFallback.
                 The sha256 pin is compiled into the binary, so a wrong file here cannot
                 weaken the check - it can only fail closed. Licenses ship beside it
                 because the model is redistributed under Apache-2.0. -->
            <Component Id="ModelComponent" Guid="{E8FCD98A-44FA-413D-9109-FE731118401B}" Bitness="always64">
              <File Id="EmbeddedModelGguf" Source="$(var.AssetsDir)\models\qwen2.5-1.5b-instruct-q4_k_m.gguf" KeyPath="yes" />
              <File Id="ModelsManifestJson" Source="$(var.AssetsDir)\models\models.manifest.json" />
            </Component>
          </Directory>

          <Directory Id="AssetsVulnDbDir" Name="vulndb">
            <!-- P37 Stage 1: the CVE lane loads a hash-pinned offline vulndb. It was never
                 authored, so the lane reported NotAvailable on every installed machine.
                 security-audit now resolves this directory relative to the executable. -->
            <Component Id="VulnDbComponent" Guid="{F13EEEDD-637F-45EA-B1B8-D8D9F62A19BF}" Bitness="always64">
              <File Id="VulnDbJson" Source="$(var.AssetsDir)\vulndb\vulndb.json" KeyPath="yes" />
              <File Id="VulnDbManifestJson" Source="$(var.AssetsDir)\vulndb\vulndb.manifest.json" />
              <File Id="CisMapJson" Source="$(var.AssetsDir)\vulndb\cis_map.json" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataRoot" Name="AetherCore">
        <Directory Id="ProgramDataState" Name="state" />
        <Directory Id="ProgramDataLogs" Name="logs" />
        <Component Id="ProgramDataComponent" Guid="{85DB878E-C90B-494B-8F8E-1C2EB07E85B9}" Bitness="always64">
          <CreateFolder Directory="ProgramDataRoot" />
          <CreateFolder Directory="ProgramDataState" />
          <CreateFolder Directory="ProgramDataLogs" />
          <!-- ForceDeleteOnUninstall: without it the Software\AetherCore key itself
               survives as an empty shell once its values are removed. -->
          <RegistryKey Root="HKLM" Key="Software\AetherCore" ForceDeleteOnUninstall="yes">
            <RegistryValue Name="InstallVersion"
                           Type="string"
                           Value="$(var.ProductVersion)"
                           KeyPath="yes" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AetherCoreProgramMenu" Name="AetherCore">
        <!-- P36 (Hermes): ICE38 root-cause fix. This component installs into
             ProgramMenuFolder (resolved to the All Users profile under the
             per-machine scope), so the ICEs require its KeyPath to be a registry
             entry under HKCU. The shortcut now lives in DesktopComponent as an
             advertised shortcut; this component only owns folder creation/removal,
             and its HKCU KeyPath satisfies ICE38/ICE43 without any suppression.
             The previous HKLM root here mixed per-machine data with a
             per-user-profile directory (the ICE57 mixing class). -->
        <Component Id="ProgramMenuComponent" Guid="{89E168CE-E5CD-45DA-97C8-20452172818C}">
          <RemoveFolder Id="RemoveAetherCoreProgramMenu" On="uninstall" />
          <!-- P37 Stage 2: ForceDeleteOnUninstall so the HKCU marker key goes too, not
               just its value. This only ever reaches the hive of the user who ran the
               install (see UNINSTALL.txt) - Windows Installer cannot enumerate other
               users' hives, and doing so would be worse behaviour, not better. -->
          <RegistryKey Root="HKCU" Key="Software\AetherCore" ForceDeleteOnUninstall="yes">
            <RegistryValue Name="ProgramMenu"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- This deferred LocalSystem action accepts only the literal verb "apply". It invokes only
         fixed System32 sc.exe/icacls.exe paths and hardens the fixed AetherCore service/directories.
         It is deliberately sequenced after InstallServices so the service exists before its service-specific
         SID/delayed-auto policy and NT SERVICE\AetherCoreMaintenance ACLs are applied, and before StartServices.
         This deliberately avoids relying on MSI ServiceConfig for SID/delayed-start semantics. -->
    <CustomAction Id="HardenInstalledSecurity"
                  FileRef="InstallHardenerExe"
                  ExeCommand="apply"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  HideTarget="yes" />
    <!-- P37 Stage 2: delete C:\ProgramData\AetherCore in full, on uninstall, AFTER the
         service is gone. Same binary, same no-arguments-from-the-command-line posture
         as the hardener above: the directory is derived from %ProgramData% inside the
         action and a reparse point anywhere in the tree is refused, not followed.

         This deliberately REPLACES util:RemoveFolderEx, which was the first
         implementation and failed the Stage 2 gate. RemoveFolderEx enumerates the
         tree before CostInitialize and Windows Installer then hard-fails at
         InstallValidate with error 2318 if anything it snapshotted has since gone.
         The maintenance service is still RUNNING at that point - StopServices is in
         the execute sequence, later - and still writing logs\service.jsonl, so the
         snapshot races a live writer. Observed on the gate: uninstall exit 1603,
         "Error 2318: File does not exist: C:\ProgramData\AetherCore\logs\service.jsonl",
         and the entire product left on disk. Scheduling after DeleteServices is the
         only ordering that cannot race. -->
    <CustomAction Id="PurgeMachineData"
                  FileRef="InstallHardenerExe"
                  ExeCommand="purge-data"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="HardenInstalledSecurity" After="InstallServices" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="PurgeMachineData" After="DeleteServices" Condition="REMOVE = &quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Feature Id="Complete" Title="AetherCore" Level="1">
      <Feature Id="Desktop" Title="AetherCore desktop" Level="1">
        <Level Condition="WINDOWSINSTALLATIONTYPE ~= &quot;Server Core&quot;" Value="0" />
        <ComponentRef Id="DesktopComponent" />
        <ComponentRef Id="ProgramMenuComponent" />
      </Feature>
      <ComponentRef Id="BrokerComponent" />
      <ComponentRef Id="UpdateBrokerComponent" />
      <ComponentRef Id="UpdateTrustComponent" />
      <ComponentRef Id="HardenerComponent" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="AetherCtlComponent" />
      <ComponentRef Id="UninstallNoticeComponent" />
      <ComponentRef Id="ModelComponent" />
      <ComponentRef Id="ModelLicenseComponent" />
      <ComponentRef Id="VulnDbComponent" />
      <ComponentRef Id="ProgramDataComponent" />
    </Feature>
  </Package>
</Wix>
