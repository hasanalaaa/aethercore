<?xml version="1.0" encoding="utf-8"?>
<!-- Arabic strings for installer/wix/theme/1025/thm.xml. The string ids are those of WiX
     v6.0.2's HyperlinkTheme.wxl (src/ext/Bal/stdbas/Resources), which installer/wix/theme/thm.wxl
     carries in English. Burn loads this file when the UI language is 1025 (locutil.cpp
     LocProbeForFile: <base>\<langid>\thm.wxl). -->
<WixLocalization Culture="ar-sa" Language="1025" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="إعداد [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="جارٍ البحث عن تحديثات" />
  <String Id="UpdateButton" Value="&amp;التحديث إلى الإصدار [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="مرحبًا" />
  <String Id="InstallMessage" Value="سيثبّت الإعداد [WixBundleName] على هذا الكمبيوتر. انقر «تثبيت» للمتابعة أو «إلغاء» للخروج." />
  <String Id="InstallMessageOptions" Value="سيثبّت الإعداد [WixBundleName] على هذا الكمبيوتر. انقر «تثبيت» للمتابعة، أو «خيارات» لضبط التثبيت، أو «إلغاء» للخروج." />
  <String Id="InstallVersion" Value="الإصدار [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="هل تريد الإلغاء فعلًا؟" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="الإصدار السابق" />
  <String Id="HelpHeader" Value="مساعدة الإعداد" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - للتثبيت أو الإصلاح أو إزالة التثبيت،&#xA;   أو لإنشاء نسخة محلية كاملة من الحزمة في المجلد. التثبيت هو الافتراضي.&#xA;&#xA;/passive | /quiet - واجهة مصغّرة بلا أسئلة، أو بلا واجهة ولا أسئلة.&#xA;   افتراضيًا تُعرض الواجهة وكل الأسئلة.&#xA;&#xA;/norestart - يمنع أي إعادة تشغيل. افتراضيًا تسأل الواجهة قبل إعادة التشغيل.&#xA;/log log.txt - يكتب السجل في ملف محدد. افتراضيًا يُكتب السجل في %WINDIR%\Temp." />
  <String Id="HelpCloseButton" Value="&amp;إغلاق" />
  <String Id="InstallLicenseLinkText" Value="&lt;a href=&quot;#&quot;&gt;شروط ترخيص&lt;/a&gt; [WixBundleName]." />
  <String Id="InstallAcceptCheckbox" Value="&amp;أوافق على شروط الترخيص وأحكامه" />
  <String Id="InstallOptionsButton" Value="&amp;خيارات" />
  <String Id="InstallInstallButton" Value="&amp;تثبيت" />
  <String Id="InstallCancelButton" Value="إ&amp;لغاء" />
