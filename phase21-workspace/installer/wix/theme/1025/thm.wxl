  <String Id="OptionsLocationLabel" Value="موقع التثبيت:" />
  <String Id="OptionsBrowseButton" Value="&amp;استعراض" />
  <String Id="OptionsOkButton" Value="&amp;موافق" />
  <String Id="OptionsCancelButton" Value="إ&amp;لغاء" />
