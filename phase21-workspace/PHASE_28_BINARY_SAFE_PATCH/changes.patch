+
+        // keep=3 (live + two generations): oldest drops, everything shifts up one slot.
+        rotate_files(&path, 3);
+        assert_eq!(std::fs::read(root.join("service.jsonl.1")).unwrap(), b"current");
+        assert_eq!(std::fs::read(root.join("service.jsonl.2")).unwrap(), b"gen1");
