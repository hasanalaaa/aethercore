+fn bottleneck_role_str(code: i32) -> &'static str {
+    match code {
+        1 => "rootCause",
+        2 => "contributingCondition",
+        3 => "symptom",
+        _ => "unspecified",
+    }
+}
+
+fn confidence_str(code: i32) -> &'static str {
+    match code {
+        1 => "low",
+        2 => "medium",
+        3 => "high",
+        4 => "confirmed",
+        _ => "unspecified",
+    }
+}
